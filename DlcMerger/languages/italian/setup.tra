@104 = ~ATTENZIONE: impossibile applicare la modifica a %resource%~

@200 = ~L'archivio DLC è danneggiato o incompleto.~
@201 = ~Impossibile unire i file KEY.~
@202 = ~Impossibile estrarre l'archivio DLC.~
@203 = ~ATTENZIONE: impossibile rinominare il file DLC. Rinomina manualmente "%dlc_filespec%" in "%dlc_res%.disabled".~
